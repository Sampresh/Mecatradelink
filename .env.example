# ─────────────────────────────────────────────────────────────
# Meca Trade Link — environment variables
# Copy to .env (server + docker) and client/.env.local (client).
# URLs never end in a trailing slash.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development                     # development | production
PORT=5001                                # Render injects its own PORT
DATABASE_URL=postgresql://meca:meca@localhost:5432/mecatradelink?schema=public   # pooled URL in production (Neon -pooler host)
DIRECT_URL=postgresql://meca:meca@localhost:5432/mecatradelink?schema=public     # direct (non-pooled) URL, used by migrations
CLIENT_URL=http://localhost:3000          # exact canonical browser origin (apex, no www) — used for CORS + email links
SERVER_PUBLIC_URL=http://localhost:5001   # public API origin, used for local upload URLs
FORCE_HTTPS=false                         # true in production to redirect http → https
TRUST_PROXY=0                             # proxy hops in front of the API: 0 locally, 1 on Render
INTERNAL_API_KEY=change-me-random-64-chars  # openssl rand -hex 32; same value on Render AND Vercel (server-only)
REVALIDATE_URL=http://localhost:3000            # site origin the API pings after admin edits (docker: http://client:3000)

JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string          # openssl rand -hex 32
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string # must differ from access secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

SMTP_HOST=smtp.gmail.com                  # leave blank in dev to log emails to the console
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password
FROM_EMAIL=no-reply@mecatradelink.com
FROM_NAME=Meca Trade Link
ENQUIRY_NOTIFY_EMAIL=sales@mecatradelink.com   # where new quote/contact enquiries are sent

ADMIN_EMAIL=admin@mecatradelink.com       # seed admin account
ADMIN_PASSWORD=change-me-strong-password  # seed refuses a weak/default password in production

CLOUDINARY_CLOUD_NAME=                    # leave all three blank in dev to store uploads on local disk
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mecatradelink

# ── Client (client/.env.local, Vercel) ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1   # browser → API
NEXT_PUBLIC_SITE_URL=http://localhost:3000         # canonical site URL for metadata/sitemap
INTERNAL_API_ORIGIN=http://localhost:5001          # server components → API (docker: http://server:5001)
UPLOADS_PROXY_ORIGIN=http://localhost:5001         # host serving /uploads in dev (allowed in next/image)
